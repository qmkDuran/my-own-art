; Engine configuration file.
config_version=5

[application]

config/name="New Jerusalem"
config/description="One screen of the holy city (Revelation 21-22)."
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Audio="*res://scripts/core/audio.gd"
Probe="*res://tests/probe.gd"
SmokeTest="*res://tests/smoke_test.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://fonts/monogram.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(1, 1, 1, 1)
