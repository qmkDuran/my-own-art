; Engine configuration file.
config_version=5

[application]

config/name="Creature Woods"
config/description="A slow third-person creature duel in the woods: stalk, hide, ambush, trap."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Tuning="*res://core/tuning.gd"
NoiseBus="*res://core/noise_bus.gd"
TestRunner="*res://tests/test_runner.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="obstacle"
3d_physics/layer_3="creature"
3d_physics/layer_4="hiding"
3d_physics/layer_5="canopy"

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.1
world/map_use_async_iterations=false
world/region_use_async_iterations=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
