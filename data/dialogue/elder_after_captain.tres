script = ExtResource("1_dialogue")
lines = PackedStringArray("The Captain knew our town? A scar over his left eye, from the old well?", "...Varn. My boy. The Wardens took him twenty winters ago.", "If his chip can crack, so can the others. Keep going. Please. Bring them home.")
