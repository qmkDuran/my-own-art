; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project R"
config/description="Project Revelation - a grounded top-down survival-action story."
run/main_scene="res://scenes/boot/disclaimer.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
DB="*res://src/autoload/db.gd"
Art="*res://src/autoload/art.gd"
GameState="*res://src/autoload/game_state.gd"
Controls="*res://src/autoload/controls.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
Router="*res://src/autoload/router.gd"
Dialogue="*res://src/autoload/dialogue.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="interactable"
2d_physics/layer_5="player_hurtbox"
2d_physics/layer_6="enemy_hurtbox"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
